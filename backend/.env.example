# Postgres connection (must match docker-compose / root .env values)
DATABASE_URL=postgresql+psycopg://bevobiz:bevobiz_dev_pw@localhost:5432/bevobiz

# Dedicated low-privilege role for the NLQ safe executor (SELECT-only on
# products/sales/businesses — see db/init/002_nlq_readonly_role.sql). Run
# that script against an existing database; it's applied automatically on
# a fresh `docker compose up`.
NLQ_DATABASE_URL=postgresql+psycopg://bevobiz_nlq_reader:bevobiz_nlq_reader_dev_pw@localhost:5432/bevobiz

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Set to "production" when deployed — the app then refuses to start with
# the built-in insecure JWT_SECRET default.
ENVIRONMENT=development

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173

# LLM adapter (Phase 4). LLM_PROVIDER selects which adapter the factory
# returns: "groq" (default — free hosted API, no local model/RAM needed)
# or "ollama" (local). LLM_MODEL is shared by both but its valid values
# are provider-specific, so set it together with LLM_PROVIDER:
#   groq:   LLM_MODEL=openai/gpt-oss-120b   (needs GROQ_API_KEY below)
#   ollama: LLM_MODEL=qwen2.5-coder:7b      (needs a local `ollama pull`)
# Groq's hosted model lineup changes over time — if LLM_MODEL ever comes
# back "not available", check https://console.groq.com/docs/models (or
# call client.models.list()) for current model IDs.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Required when LLM_PROVIDER=groq. Get a free key at https://console.groq.com/keys
# — never commit a real key here; this file is a template.
GROQ_API_KEY=your-groq-api-key-here

# Only used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
